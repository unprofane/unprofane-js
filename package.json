{
  "name": "@unprofane/sdk",
  "version": "0.1.6",
  "description": "Unprofane: a profanity and toxicity API that is hard to fool. Typed client with retries and a batch helper.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unprofane/unprofane-js.git"
  },
  "homepage": "https://unprofane.com/docs/",
  "keywords": [
    "profanity",
    "toxicity",
    "moderation",
    "filter",
    "perspective-api",
    "unprofane"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "bugs": {
    "url": "https://github.com/unprofane/unprofane-js/issues"
  }
}
